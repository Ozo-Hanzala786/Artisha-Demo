// Prisma schema for Artisha E-Commerce & Business Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("CUSTOMER") // SUPER_ADMIN, MANAGER, INVENTORY_MANAGER, ORDER_MANAGER, MARKETING_MANAGER, CUSTOMER
  phone        String?
  avatar       String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     Wishlist[]
  stockMovements StockMovement[]
  auditLogs    AuditLog[]
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String   @default("Home") // Home, Office, Other
  recipientName String
  phone         String
  streetAddress String
  city          String
  postalCode    String?
  province      String?  @default("Punjab")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?
  featured     Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products     Product[]
}

model Product {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  sku               String           @unique
  description       String
  shortDescription  String?
  price             Float
  salePrice         Float?
  costPrice         Float            @default(0.0) // For real profit calculations
  stock             Int              @default(0)
  lowStockThreshold Int              @default(5)
  isFeatured        Boolean          @default(false)
  isBestseller      Boolean          @default(false)
  isNewArrival      Boolean          @default(false)
  status            String           @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  images            String           // JSON stringified array of image URLs
  material          String?
  careInstructions  String?
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  orderItems        OrderItem[]
  reviews           Review[]
  wishlist          Wishlist[]
  stockMovements    StockMovement[]
}

model ProductVariant {
  id         String     @id @default(cuid())
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String     @unique
  name       String     // e.g. "Crimson Silk / Small"
  size       String?
  color      String?
  material   String?
  price      Float?
  salePrice  Float?
  stock      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  orderItems OrderItem[]
  stockMovements StockMovement[]
}

model StockMovement {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type          String          // RESTOCK, ORDER_DEDUCT, ORDER_RESTORE, MANUAL_ADJUSTMENT, DAMAGE, RETURN
  quantity      Int             // Positive for additions, negative for deductions
  reason        String
  referenceNote String?
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    // PERCENTAGE, FIXED, FREE_SHIPPING
  value         Float     // percentage value or fixed amount
  minSpend      Float     @default(0)
  maxDiscount   Float?
  usageLimit    Int?
  usedCount     Int       @default(0)
  startDate     DateTime  @default(now())
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Order {
  id              String               @id @default(cuid())
  orderNumber     String               @unique // ART-10001
  userId          String?
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  shippingAddress String               // Full address string or JSON
  city            String
  postalCode      String?
  shippingMethod  String               @default("STANDARD") // STANDARD, EXPRESS, STORE_PICKUP
  shippingCost    Float                @default(250.0)
  paymentMethod   String               @default("COD") // COD, BANK_TRANSFER, JAZZCASH, EASYPAISA, CARD
  paymentStatus   String               @default("PENDING") // PENDING, VERIFIED, FAILED, REFUNDED
  orderStatus     String               @default("PENDING") // PENDING, CONFIRMED, PROCESSING, PACKED, SHIPPED, DELIVERED, CANCELLED, RETURNED, REFUNDED
  subtotal        Float
  discountAmount  Float                @default(0.0)
  couponCode      String?
  totalAmount     Float
  trackingNumber  String?
  courierName     String?              // TCS, Leopards, Trax, M&P
  customerNotes   String?
  internalNotes   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  items           OrderItem[]
  payments        PaymentTransaction[]
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name       String
  sku        String
  price      Float
  quantity   Int
  subtotal   Float
  imageUrl   String?
}

model PaymentTransaction {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Float
  paymentMethod  String
  status         String    @default("PENDING") // PENDING, VERIFIED, FAILED, REFUNDED
  transactionRef String?
  bankAccount    String?
  slipUrl        String?
  notes          String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName         String
  rating             Int      // 1 to 5
  comment            String
  isVerifiedPurchase Boolean  @default(false)
  status             String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt          DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String   // RENT, SALARIES, INVENTORY, MARKETING, PACKAGING, COURIER, UTILITIES, MISC
  amount      Float
  date        DateTime @default(now())
  description String?
  receiptUrl  String?
  recordedBy  String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // ORDER_NEW, ORDER_CANCELLED, STOCK_LOW, STOCK_OUT, CUSTOMER_NEW, PAYMENT_RECEIVED
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model WebsiteContent {
  id        String   @id @default(cuid())
  key       String   @unique // hero, announcement, story, contact, policies, faqs, social
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

model ShippingZone {
  id                    String   @id @default(cuid())
  city                  String   @unique
  rate                  Float
  estimatedDays         String   @default("2-3 business days")
  freeShippingThreshold Float?
  isActive              Boolean  @default(true)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  userRole   String
  action     String   // e.g. "UPDATE_ORDER_STATUS", "STOCK_ADJUSTMENT", etc.
  entityType String   // Order, Product, Expense, etc.
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)
}
